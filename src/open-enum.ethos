; The contract of an open enum: its variants are data, each a name and the
; type it carries. A Signal that names open enums generates Name, Word,
; Variant and the Type, Import and Declaration they hold once, as the module
; `_open` its open enums share, written where the syntax module is not yet
; imported from; each open enum's module, named for the enum, re-exports it
; and holds its own Input and Output.
Library
[]
[ Name.String
  Word.String
  Import.{ Namespace.⟦Word⟧
           ⟦Name⟧ }
  Declaration.{ Name Type }
  Variant.{ Name Option<Type> }
  Type.[ Name
         Import
         Declaration
         Struct.⟦Type⟧
         Enum.⟦Variant⟧
         Vector.Type
         Applied.{ Name ⟦Type⟧ } ]
  Input.[ Add.Variant
          Remove.Name
          List ]
  Output.[ Added.Variant
           Removed.Name
           Listed.⟦Variant⟧
           Refused.String ] ]
[]
[]
