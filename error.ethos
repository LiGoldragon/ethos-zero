; The errors the ethos reader raises: structural, from the protos reading, or conceptual, at a path;
; and where an error lies in the source text, its line and column counted from one.
Library
[ protos:[ Extent Separator ] ]
[ Structural_Error.{ Extent
                     protos:Problem }
  Error.[ Structural.Structural_Error
          Conceptual.{ ⟦ Integer ⟧ Problem } ]
  Problem.[ Unrooted
            Arity.{ Integer Integer }
            Expected.Form
            Separator
            Name
            Duplicate.Name
            Undeclared.Name
            Cycle.Name
            Yield
            Empty
            Depth
            Role.Name
            Intrinsic.Name
            Case.Name
            Renamed.Successor
            Wrapping.{ String String }
            DuplicateField.Field
            Unpaired.Name
            TooFewVariants.Name
            Placement.Name
            Foreign.Name
            Unborn.Name
            Ungivable.Name
            Namespace
            UnknownName.{ Namespace Name }
            Unpointed.Namespace
            Misrooted.{ Namespace Name }
            Ambiguous.Name ]
  Form.[ File Section Import Symbol Declaration Variant Reference Constraint Trait Capability Constant Association Process Pointer ]
  Name.String
  Namespace.String
  Successor.String
  Field.String
  Location.{ Line Column }
  Line.Integer
  Column.Integer ]
