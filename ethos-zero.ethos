; The local Datom command contract, not a wire Signal.
; Generate reads an ethos file and writes its Rust module into a directory;
; Check reads and validates it whole, writing nothing. A rejection names the
; file, the line and column of the error in it, and the error.
; The files read are of four roots, each section in this order:
;   Library    [ imports ] [ types ] [ traits ] [ associations ]
;   Signal     [ imports ] [ queries ] [ responses ] [ types ]
;   Operation  [ imports ] [ operations ] [ outcomes ] [ types ]   ; proposed, pending the living's word
;   Memory     [ imports ] [ record types ]
; A file headed Sema is refused as Renamed.Memory.
Library
[ datom_codec:[ Error ]
  ethos_zero:[ Problem Location ] ]
[ Query.[ Generate.Generation
          Check.String ]
  Response.[ Generated.Vector<String>
             Checked.String
             Arguments.Integer
             Malformed.Error
             Unreadable.{ String String }
             Rejected.{ String Location Generation_Error }
             Unwritable.{ String String } ]
  Generation.{ String String }
  Generation_Error.[ Structural.protos:Error
                     Conceptual.{ Vector<Integer>
                                  ethos_zero:Problem } ] ]
[]
[]
